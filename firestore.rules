rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /printRequests/{requestId} {
      allow create: if true;                 // public customer submit
      allow read, update, delete: if request.auth != null; // shop owner only
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
